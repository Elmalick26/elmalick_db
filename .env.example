# .env.example — متغيرات البيئة المطلوبة
# انسخ هذا الملف إلى .env واملأ القيم الحقيقية
# NEVER commit .env — it contains secrets

# ── API Security ──────────────────────────────────
# مفتاح سري لتوليد JWT tokens (استخدم قيمة عشوائية طويلة)
ELMALICK_API_SECRET_KEY=change-this-to-a-long-random-secret-key-at-least-32-chars

# ── Database ──────────────────────────────────────
# كلمة مرور PostgreSQL (إذا لم تكن محفوظة في config.ini)
DB_PASSWORD=your_postgresql_password_here

# ── CORS ─────────────────────────────────────────
# النطاقات المسموح بها للـ API (مفصولة بفاصلة)
# في التطوير: * (أي نطاق)
# في الإنتاج: https://yourapp.com,https://portal.yourapp.com
ALLOWED_ORIGINS=*

# ── Rate Limiting ────────────────────────────────
# الحد الأقصى لمحاولات تسجيل الدخول في الدقيقة
AUTH_RATE_LIMIT=5/minute
PARENT_RATE_LIMIT=10/minute
