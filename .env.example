# .env.example — متغيرات البيئة المطلوبة
# انسخ هذا الملف إلى .env واملأ القيم الحقيقية
# NEVER commit .env — it contains secrets
# لتوليد مفتاح عشوائي:  python -c "import secrets; print(secrets.token_hex(32))"

# ── Environment ───────────────────────────────────
# القيمة: development | production
# في الإنتاج: تُفعَّل كل فحوصات الأمان (fail-fast على المفاتيح الافتراضية)
ELMALICK_ENV=development

# ── API Security ──────────────────────────────────
# مفتاح سري لتوليد JWT tokens — مطلوب في الإنتاج (>= 32 حرف عشوائي)
# اسم المتغير: ELMALICK_API_SECRET (وليس ELMALICK_API_SECRET_KEY)
ELMALICK_API_SECRET=change-this-to-a-long-random-secret-key-at-least-32-chars

# ── Database ──────────────────────────────────────
# كلمة مرور PostgreSQL (إذا لم تكن محفوظة في Windows Credential Manager)
ELMALICK_DB_PASSWORD=your_postgresql_password_here

# ── CORS ─────────────────────────────────────────
# النطاقات المسموح بها للـ API (مفصولة بفاصلة)
# في التطوير: http://localhost:8000 (wildcard يُعطِّل الـ credentials تلقائياً)
# في الإنتاج: https://yourapp.com,https://portal.yourapp.com
ALLOWED_ORIGINS=http://localhost:8000

# ── Monitoring ────────────────────────────────────
# DSN اختياري لـ Sentry — اتركه فارغاً لتعطيل التتبع
SENTRY_DSN=

# ── Rate Limiting ────────────────────────────────
# الحد الأقصى لمحاولات تسجيل الدخول في الدقيقة (قيم افتراضية محددة في الكود)
AUTH_RATE_LIMIT=5/minute
PARENT_RATE_LIMIT=10/minute
